#!/bin/bash
# hsbg 命令行包装器。
#
# 为什么要有这个文件：本机 Python 是 /usr/bin/python3 (3.9.6)，项目零第三方依赖，
# 不需要 venv。直接用 PYTHONPATH 指向 src 就能跑，省掉安装步骤。
#
# 用法:
#   ./hsbg sessions
#   ./hsbg check
#   ./hsbg parse --limit 30
#   ./hsbg stream
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec /usr/bin/env PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}" /usr/bin/python3 -m hsbg "$@"
